# Home Assistant sensitive data & Philips Hue auth tokens
config/.storage/
config/.cloud/
config/secrets.yaml
config/*.pem
config/*.key

# Downloaded third-party code / integrations
config/custom_components/
config/deps/
config/www/community/

# Runtime state and caches
config/.cache/
config/.ha_run.lock
config/.HA_VERSION

# Databases, logs, and temporary files
config/*.db*
config/*.log*
config/backups/
config/tts/
config/blueprints/
**/__pycache__/
